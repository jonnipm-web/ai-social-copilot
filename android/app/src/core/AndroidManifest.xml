<?xml version="1.0" encoding="utf-8"?>
<!-- IV-MOBILE-ECOSYSTEM-FOUNDATION-01 — Core flavor manifest overlay.
     Merged into android/app/src/main/AndroidManifest.xml by the Android
     manifest merger during a 'core' flavor build. Only elements specific
     to the Core product are declared here; everything else comes from main.

     Deep link scheme: insightvalues://core/<path>
     Examples:
       insightvalues://core/home
       insightvalues://core/upgrade

     PRODUCTION PROTECTION: autoVerify="false" until assetlinks.json for
     com.insightvalues.core is deployed to insightvalues.com/.well-known/.
     Do NOT enable autoVerify="true" without that file in place. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity android:name=".MainActivity">
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="insightvalues" android:host="core"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
