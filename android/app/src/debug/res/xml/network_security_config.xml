<?xml version="1.0" encoding="utf-8"?>
<!-- DEBUG builds only (src/debug): allows cleartext HTTP to the loopback
     address, which `adb reverse` maps to a local dev server on the PC
     (Lab physical validation: Quant READINESS-03, Impact I6-PHYSICAL-CLOSURE).
     Every other host keeps the platform default (cleartext blocked).
     Release/profile builds never include this file. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
