# android/key.properties.template
#
# IV-CORE-MOBILE-COMMERCIAL-01 — Owner keystore configuration template.
#
# USAGE (BLOCKED_OWNER — must be done by Owner only):
#
#   1. Generate the upload keystore LOCALLY (never in CI):
#        keytool -genkey -v -keystore upload-keystore.jks \
#          -storetype JKS -keyalg RSA -keysize 2048 -validity 10000 \
#          -alias upload
#      Store the keystore file securely (password manager, offline backup).
#
#   2. Copy this file to android/key.properties (never committed -- see
#      android/.gitignore):
#        cp android/key.properties.template android/key.properties
#
#   3. Fill in the values below in android/key.properties.
#
#   4. For CI (build-release-aab.yml), store the following in GitHub Secrets
#      (Settings → Secrets and variables → Actions):
#        KEYSTORE_BASE64         → base64 -i upload-keystore.jks | tr -d '\n'
#        KEYSTORE_STORE_PASSWORD → same as storePassword below
#        KEYSTORE_KEY_ALIAS      → same as keyAlias below
#        KEYSTORE_KEY_PASSWORD   → same as keyPassword below
#
#   SECURITY NOTE: Any secrets previously stored in these GitHub Secret slots
#   from the now-disabled generate-keystore.yml (PLAY-READINESS-18 incident)
#   MUST be deleted and replaced with new credentials from your new keystore
#   before the release workflow is used.
#
# NEVER COMMIT android/key.properties — it is in android/.gitignore.

storePassword=REPLACE_WITH_YOUR_STORE_PASSWORD
keyPassword=REPLACE_WITH_YOUR_KEY_PASSWORD
keyAlias=REPLACE_WITH_YOUR_KEY_ALIAS
storeFile=../upload-keystore.jks
