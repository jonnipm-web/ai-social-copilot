    {
      "title": "aef-receipt/1 EXECUTION (legacy, read-only)",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_version",
        "receipt_id",
        "operation_id",
        "request_id",
        "subject_id",
        "domain",
        "action",
