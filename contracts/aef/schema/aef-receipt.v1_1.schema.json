              }
            }
          },
          "then": {
            "properties": {
              "outcome": {
                "enum": [
                  "NOT_EXECUTED"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "final_state": {
                "const": "EXPIRED"
              }
            }
          },
          "then": {
            "properties": {
              "outcome": {
                "enum": [
                  "NOT_EXECUTED"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "final_state": {
                "const": "CANCELLED"
              }
            }
          },
          "then": {
            "properties": {
              "outcome": {
                "enum": [
                  "NOT_EXECUTED"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "final_state": {
                "const": "INVALIDATED"
              }
            }
          },
          "then": {
            "properties": {
              "outcome": {
                "enum": [
                  "NOT_EXECUTED"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "resource_type": {
                "const": null
              }
            }
          },
