          "type": [
            "boolean",
            "null"
          ]
        },
        "attempt_count": {
          "enum": [
            0,
            1
          ]
        },
        "registered_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{6}Z$"
        },
        "authorized_at": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{6}Z$"
        },
        "completed_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{6}Z$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "final_state": {
                "const": "SUCCEEDED"
              }
            }
          },
          "then": {
            "properties": {
              "outcome": {
                "enum": [
                  "SUCCESS"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "final_state": {
                "const": "FAILED"
              }
            }
          },
          "then": {
            "properties": {
              "outcome": {
                "enum": [
                  "FAILURE",
                  "PARTIAL"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "final_state": {
                "const": "UNKNOWN_OUTCOME"
              }
            }
          },
          "then": {
            "properties": {
              "outcome": {
                "enum": [
                  "UNKNOWN_OUTCOME"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "final_state": {
