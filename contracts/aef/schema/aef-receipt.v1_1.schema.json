        },
        "subject_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "domain": {
          "enum": [
            "core",
            "quant",
            "impact",
            "internal"
          ]
        },
        "action": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*([.][a-z][a-z0-9_]*)+$"
        },
        "tool_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "action_class": {
          "enum": [
            "READ_ONLY",
            "REVERSIBLE",
            "CONSEQUENTIAL"
          ]
        },
        "resource_type": {
          "enum": [
            "project",
            null
          ]
        },
        "resource_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "binding_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "payload_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "policy_version": {
          "type": "string",
          "pattern": "^[a-z0-9._/-]{1,64}$"
        },
        "risk_version": {
